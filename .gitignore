# Secrets — never commit real env files
.env
.env.local
.env.*.local
!.env.example

# Personal data — the REAL profile + memory live ONLY in the VM, never here.
# (The tracked templates are profile.example.yaml / USER.example.md, which don't match these.)
profile.yaml
USER.md
USER_DETAIL.md
**/sidekick/profile.yaml
**/memories/*.md

# Any raw (unredacted) env captured locally
*.env.raw
docs/backups/*.env.raw

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Logs
*.log

# Internal strategy notes — never publish
*.local.md

# Local benchmark results and generated synthetic packs (never commit)
.bench/

# Python verification artifacts
__pycache__/
*.pyc
.venv/

# Controlled browser dependencies and local runtime fixtures
sidekick_control/node_modules/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
