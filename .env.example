# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Hermes runs INSIDE the OrbStack VM `hermes`. Real secrets live in the VM
# at ~/.hermes/.env (gitignored, chmod 600) — NOT in this host folder.
# This file only DOCUMENTS what to set there. Add a key without exposing it:
#
#   orb run -m hermes bash -lc 'read -rsp "key: " K; echo; \
#     printf "\nNAME=%s\n" "$K" >> ~/.hermes/.env'
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider (current: direct Anthropic) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Alternative providers (pick ONE; see VM ~/.hermes/.env for the full list) ─
# OPENROUTER_API_KEY=sk-or-...        # routes to anthropic/claude-*, and 300+ others

# ── Optional tool keys (web search, scraping, etc.) ─────────────────────────
# EXA_API_KEY=
# FIRECRAWL_API_KEY=

# ── Messaging transport (current: Signal via a signal-cli daemon in the VM) ──
SIGNAL_ACCOUNT=+1XXXXXXXXXX             # the agent's own number (e.g. a Google Voice number)
SIGNAL_HTTP_URL=http://127.0.0.1:8080   # signal-cli daemon (loopback, inside the VM)
SIGNAL_ALLOWED_USERS=+1XXXXXXXXXX       # who may talk to it (your personal number)
SIGNAL_ALLOW_ALL_USERS=false
SIGNAL_HOME_CHANNEL=+1XXXXXXXXXX        # proactive/cron delivery target (you)
SIGNAL_REACTIONS=false                  # no emoji reactions on your inbound messages

# ── Other messaging options (not enabled) ───────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# ── Integrations: Gmail (self-hosted Google Workspace MCP, runs in the VM) ───
# The OAuth client SECRET is never here — it stays in client_secret.json in the VM.
# These are paths/identity only (set in the VM's ~/.hermes/.env and the gmail MCP config):
# GOOGLE_CLIENT_SECRET_PATH=/home/<user>/.hermes/google-workspace/client_secret.json
# WORKSPACE_MCP_CREDENTIALS_DIR=/home/<user>/.hermes/google-workspace/.credentials
# USER_GOOGLE_EMAIL=you@gmail.com

# ── Host-side control-folder config (this repo, optional) ───────────────────
# HERMES_VM=hermes                    # name of the OrbStack VM to target
